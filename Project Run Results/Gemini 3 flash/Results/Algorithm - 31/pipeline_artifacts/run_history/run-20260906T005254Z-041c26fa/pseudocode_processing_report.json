      "source": "FUNCTION CoreferenceResolution(text):\n    tokens, pos_tags = TokenizeAndTag(text)\n    entities <- ExtractNamedEntities(tokens, pos_tags)\n    pronouns <- ExtractPronouns(tokens, pos_tags)\n    \n    resolved_text <- text\n    FOR EACH pronoun IN pronouns DO\n        antecedent <- FindMostCompatibleEntity(pronoun, entities, search_window=2_sentences)\n        IF antecedent IS NOT NULL THEN\n            ReplaceInText(resolved_text, pronoun, antecedent.name)\n        END IF\n    END FOR\n    \n    RETURN resolved_text\nEND FUNCTION",
